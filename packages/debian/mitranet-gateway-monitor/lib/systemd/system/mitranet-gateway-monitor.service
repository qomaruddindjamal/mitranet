[Unit]
Description=MitraNet Gateway Health & Latency Monitor
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/mitranet-gateway-monitor --daemon
Restart=always
RestartSec=5s
User=root
StandardOutput=journal
StandardError=journal

# Security hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/mitranet /run/mitranet
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
