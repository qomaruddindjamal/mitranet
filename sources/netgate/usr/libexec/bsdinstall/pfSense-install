BSDINSTALL_INC_PATH="/usr/libexec/bsdinstall"
. "${BSDINSTALL_INC_PATH}/pfSense-common"

DESTDIR="${BSDINSTALL_CHROOT:-/mnt}"
echo "=== Installing MitraNet OS Offline ==="
for dir in bin boot etc lib libexec root sbin usr var conf.default cf conf; do
	if [ -d "/${dir}" ]; then
		echo "Extracting /${dir} to ${DESTDIR}/${dir}..."
		mkdir -p "${DESTDIR}/${dir}"
		tar -cf - -C "/${dir}" . | tar -xf - -C "${DESTDIR}/${dir}"
	fi
done
if [ -d "/rescue" ]; then
	echo "Extracting /rescue to ${DESTDIR}/rescue..."
	mkdir -p "${DESTDIR}/rescue"
	tar -cf - -C "/rescue" . | tar -xf - -C "${DESTDIR}/rescue"
fi
for dir in dev media mnt proc tmp cf/conf; do
	mkdir -p "${DESTDIR}/${dir}"
done
chmod 1777 "${DESTDIR}/tmp"
ln -sf /cf/conf "${DESTDIR}/conf" 2>/dev/null || true

# Detect root filesystem type and device
ROOT_DEV=""
ROOT_FSTYPE="zfs"

# Check what is currently mounted on ${DESTDIR}
mount_info=$(mount | grep "on ${DESTDIR} " | head -n 1)
if [ -n "${mount_info}" ]; then
    ROOT_DEV=$(echo "${mount_info}" | awk '{print $1}')
    case "${mount_info}" in
        *"(ufs"*|*"ufs,"*)
            ROOT_FSTYPE="ufs"
            ;;
        *"(zfs"*|*"zfs,"*)
            ROOT_FSTYPE="zfs"
            ;;
    esac
fi

# Fallback: check if ROOT_DEV starts with /dev/
if echo "${ROOT_DEV}" | grep -q "^/dev/"; then
    ROOT_FSTYPE="ufs"
elif [ -z "${ROOT_DEV}" ]; then
    if zpool status pfSense 2>/dev/null | grep -q "pool: pfSense"; then
        ROOT_FSTYPE="zfs"
    else
        for d in da0 ada0 vtbd0 nvd0 nda0; do
            p=$(gpart show -p "${d}" 2>/dev/null | awk '/freebsd-ufs/ { print $3 }' | head -n 1)
            if [ -n "${p}" ]; then
                ROOT_DEV="/dev/${p}"
                ROOT_FSTYPE="ufs"
                break
            fi
        done
    fi
fi

echo "Detected root filesystem: ${ROOT_FSTYPE} on ${ROOT_DEV:-default}"

# Clean /etc/fstab for installed system - do NOT keep ISO cd9660 mount!
cat << 'EOF' > "${DESTDIR}/etc/fstab"
# Device	Mountpoint	FStype	Options	Dump	Pass#
EOF

# If UFS, determine root device and write to fstab
if [ "${ROOT_FSTYPE}" = "ufs" ]; then
    ufs_dev="${ROOT_DEV}"
    if [ -z "${ufs_dev}" ]; then
        for d in da0 ada0 vtbd0 nvd0 nda0; do
            p=$(gpart show -p "${d}" 2>/dev/null | awk '/freebsd-ufs/ { print $3 }' | head -n 1)
            if [ -n "${p}" ]; then
                ufs_dev="/dev/${p}"
                break
            fi
        done
    fi
    [ -z "${ufs_dev}" ] && ufs_dev="/dev/ada0p4"
    case "${ufs_dev}" in
        /dev/*) ;;
        *) ufs_dev="/dev/${ufs_dev}" ;;
    esac
    echo "${ufs_dev}	/	ufs	rw	1	1" >> "${DESTDIR}/etc/fstab"
fi

# Auto-detect and add swap if present
for d in da0 ada0 vtbd0 nvd0 nda0; do
    swap_part=$(gpart show -p "${d}" 2>/dev/null | awk '/freebsd-swap/ { print $3 }' | head -n 1)
    if [ -n "${swap_part}" ] && [ -e "/dev/${swap_part}" ]; then
        echo "/dev/${swap_part}	none	swap	sw	0	0" >> "${DESTDIR}/etc/fstab"
        break
    fi
done

# Configure loader.conf and ZFS/UFS services
if [ "${ROOT_FSTYPE}" = "ufs" ]; then
    cat << EOF > "${DESTDIR}/boot/loader.conf"
kern.shutdown.secure_halt="1"
kern.geom.label.disk_ident.enable="0"
kern.geom.label.gptid.enable="0"
autoboot_delay="3"
vfs.root.mountfrom="ufs:${ufs_dev}"
vfs.mountroot.timeout="30"
kern.cam.boot_delay="10000"
kern.cam.scsi_delay="10000"
loader_conf_files="/boot/loader.conf.lua"
EOF
    ZFS_ENABLE="NO"
else
    mkdir -p "${DESTDIR}/boot/zfs"
    zpool set cachefile="${DESTDIR}/boot/zfs/zpool.cache" pfSense 2>/dev/null || true
    if [ -f "${DESTDIR}/boot/zfs/zpool.cache" ]; then
        cp -f "${DESTDIR}/boot/zfs/zpool.cache" /boot/zfs/zpool.cache 2>/dev/null || true
    fi

    cat << 'EOF' > "${DESTDIR}/boot/loader.conf"
kern.shutdown.secure_halt="1"
kern.geom.label.disk_ident.enable="0"
kern.geom.label.gptid.enable="0"
autoboot_delay="3"
zfs_load="YES"
zpool_cache_load="YES"
zpool_cache_type="/boot/zfs/zpool.cache"
zpool_cache_name="/boot/zfs/zpool.cache"
vfs.root.mountfrom="zfs:pfSense/ROOT/default"
vfs.mountroot.timeout="30"
kern.cam.boot_delay="10000"
kern.cam.scsi_delay="10000"
loader_conf_files="/boot/loader.conf.lua"
EOF
    ZFS_ENABLE="YES"
fi

cat << EOF > "${DESTDIR}/etc/rc.conf"
hostname="mitranet"
root_rw_mount="YES"
zfs_enable="${ZFS_ENABLE}"
nginx_enable="YES"
sshd_enable="YES"
gateway_enable="YES"
ifconfig_DEFAULT="DHCP"
ifconfig_em0="DHCP"
ifconfig_vtnet0="DHCP"
ifconfig_hn0="DHCP"
ifconfig_re0="DHCP"
ifconfig_igb0="DHCP"
ifconfig_le0="DHCP"
sendmail_enable="NONE"
clear_tmp_enable="YES"
EOF

# Setup SSL certificate for Nginx on target disk
mkdir -p "${DESTDIR}/var/etc"
if [ -f "/var/etc/cert.pem" ] && [ -f "/var/etc/cert.key" ]; then
    cp -f /var/etc/cert.* "${DESTDIR}/var/etc/" 2>/dev/null || true
fi

# Ensure config.xml exists
mkdir -p "${DESTDIR}/cf/conf"
if [ ! -f "${DESTDIR}/cf/conf/config.xml" ] && [ -f "${DESTDIR}/conf.default/config.xml" ]; then
    cp -f "${DESTDIR}/conf.default/config.xml" "${DESTDIR}/cf/conf/config.xml"
fi

# Clean up rc.local so installed system auto-starts all services
cat << 'EOF' > "${DESTDIR}/etc/rc.local"
# Ensure SSL cert exists for Nginx
if [ ! -f "/var/etc/cert.pem" ]; then
    mkdir -p /var/etc
    /usr/bin/openssl req -new -x509 -days 3650 -nodes \
        -subj "/C=ID/ST=Indonesia/L=Jakarta/O=MitraNet/CN=mitranet.local" \
        -newkey rsa:2048 -keyout /var/etc/cert.key -out /var/etc/cert.pem 2>/dev/null
fi

# Setup PHP configuration and start php-fpm for pfSense WebGUI
/etc/rc.php_ini_setup 2>/dev/null || true
if [ -x "/etc/rc.php-fpm_restart" ]; then
    /etc/rc.php-fpm_restart 2>/dev/null || true
elif [ -x "/usr/local/sbin/php-fpm" ]; then
    /usr/local/sbin/php-fpm -c /usr/local/etc/php.ini 2>/dev/null || true
fi

# Start Nginx WebGUI
/usr/local/etc/rc.d/nginx start 2>/dev/null || /usr/local/sbin/nginx 2>/dev/null || true

# --- MitraNet Network Enhancements Auto-Start ---
if [ -x "/usr/local/bin/mitranet-web" ]; then
    MITRANET_API_PORT=8080 /usr/local/bin/mitranet-web > /var/log/mitranet-api.log 2>&1 &
fi
if [ -f "/usr/local/etc/xray/config.json" ] && [ -x "/usr/local/etc/rc.d/xray" ]; then
    /usr/local/etc/rc.d/xray onestart 2>/dev/null || true
fi
EOF

# Set clean boot.config on target (prevent serial port blocking)
echo "-D" > "${DESTDIR}/boot.config"

# Set MitraNet banner for motd and shell login
cat << 'EOF' > "${DESTDIR}/etc/motd"
==================================================================
           MitraNet OS - High Performance Network Gateway         
==================================================================
  WebGUI Management:  https://192.168.1.1 (or assigned DHCP IP)
  Default Account:    admin / pfsense  (SSH: root / pfsense)
  Core Services:      Nginx WebGUI, Xray Core, BSD Packet Filter
==================================================================
EOF
cp -f "${DESTDIR}/etc/motd" "${DESTDIR}/etc/motd.template" 2>/dev/null || true

# Clean root shell rc
cat << 'EOF' > "${DESTDIR}/root/.shrc"
PS1="\u@\h:\w \\$ "
[ -f /etc/motd ] && cat /etc/motd
EOF

# Ensure python3 symlink and execution permissions
ln -sf python3.11 "${DESTDIR}/usr/local/bin/python3" 2>/dev/null || true
chmod 755 "${DESTDIR}/usr/local/bin/mitranet"* 2>/dev/null || true

# Set default password 'pfsense' for root and admin, permit root SSH
if [ -f "${DESTDIR}/etc/master.passwd" ]; then
    sed -i '' 's|/usr/local/libexec/installer/pfSense-installer.sh|/bin/sh|g' "${DESTDIR}/etc/master.passwd" 2>/dev/null || true
    sed -i '' 's|/usr/local/libexec/installer/pfSense-installer.sh|/bin/sh|g' "${DESTDIR}/etc/passwd" 2>/dev/null || true
    pwd_mkdb -d "${DESTDIR}/etc" "${DESTDIR}/etc/master.passwd" 2>/dev/null || true
    echo "pfsense" | chroot "${DESTDIR}" pw mod user root -h 0 2>/dev/null || true
    echo "pfsense" | chroot "${DESTDIR}" pw mod user admin -h 0 2>/dev/null || true
fi
echo "PermitRootLogin yes" >> "${DESTDIR}/etc/ssh/sshd_config"

# Clean up installer triggers on target installed system
rm -rf "${DESTDIR}/usr/local/libexec/installer"
rm -f "${DESTDIR}/etc/is_installer_media"

# --- Universal Dual Bootloader (UEFI ESP + BIOS PMBR/GPT) for all disks ---
for disk in da0 ada0 vtbd0 nvd0 nda0; do
	if [ ! -e "/dev/${disk}" ]; then
		continue
	fi

	part_scheme=$(gpart show "${disk}" 2>/dev/null | head -n 1 | awk '{print $4}')
	[ -z "${part_scheme}" ] && continue

	echo "Configuring bootloader on /dev/${disk} (${part_scheme})..."

	# A. UEFI ESP Setup
	efi_part=$(gpart show -p "${disk}" 2>/dev/null | awk '/efi/ { print $3 }' | head -n 1)
	if [ -n "${efi_part}" ] && [ -e "/dev/${efi_part}" ]; then
		echo "Installing UEFI bootloader on /dev/${efi_part}..."
		mkdir -p /tmp/esp
		if ! mount -t msdosfs "/dev/${efi_part}" /tmp/esp 2>/dev/null; then
			newfs_msdos "/dev/${efi_part}" 2>/dev/null || true
			mount -t msdosfs "/dev/${efi_part}" /tmp/esp 2>/dev/null || true
		fi

		if mount | grep -q "/tmp/esp"; then
			mkdir -p /tmp/esp/EFI/BOOT /tmp/esp/EFI/freebsd
			if [ -f "/boot/loader.efi" ]; then
				cp -f "/boot/loader.efi" /tmp/esp/EFI/BOOT/BOOTX64.EFI
				cp -f "/boot/loader.efi" /tmp/esp/EFI/BOOT/bootx64.efi
				cp -f "/boot/loader.efi" /tmp/esp/EFI/freebsd/loader.efi
			fi
			cat << 'NSH_EOF' > /tmp/esp/startup.nsh
fs0:
\EFI\BOOT\BOOTX64.EFI
fs1:
\EFI\BOOT\BOOTX64.EFI
NSH_EOF
			sync
			umount /tmp/esp 2>/dev/null || true
			echo "UEFI ESP bootloader installed successfully on /dev/${efi_part}."
		fi
	fi

	# B. Legacy BIOS Boot Setup
	if [ "${part_scheme}" = "GPT" ]; then
		boot_part_idx=$(gpart show -p "${disk}" 2>/dev/null | awk '/freebsd-boot/ { print $3 }' | head -n 1 | sed -e 's/.*p//' -e 's/.*s//')
		if [ -n "${boot_part_idx}" ]; then
			echo "Installing GPT BIOS bootcode on /dev/${disk} (partition ${boot_part_idx}, filesystem: ${ROOT_FSTYPE})..."
			if [ "${ROOT_FSTYPE}" = "ufs" ]; then
				if [ -f "/boot/pmbr" ] && [ -f "/boot/gptboot" ]; then
					gpart bootcode -b /boot/pmbr -p /boot/gptboot -i "${boot_part_idx}" "${disk}" 2>/dev/null || true
				elif [ -f "/boot/pmbr" ] && [ -f "/boot/gptzfsboot" ]; then
					gpart bootcode -b /boot/pmbr -p /boot/gptzfsboot -i "${boot_part_idx}" "${disk}" 2>/dev/null || true
				fi
			else
				if [ -f "/boot/pmbr" ] && [ -f "/boot/gptzfsboot" ]; then
					gpart bootcode -b /boot/pmbr -p /boot/gptzfsboot -i "${boot_part_idx}" "${disk}" 2>/dev/null || true
				elif [ -f "/boot/pmbr" ] && [ -f "/boot/gptboot" ]; then
					gpart bootcode -b /boot/pmbr -p /boot/gptboot -i "${boot_part_idx}" "${disk}" 2>/dev/null || true
				fi
			fi
			# CRITICAL FOR VIRTUALBOX BIOS: active flag on PMBR prevents 'FATAL: No bootable medium found'
			gpart set -a active "${disk}" 2>/dev/null || true
			gpart set -a bootme -i "${boot_part_idx}" "${disk}" 2>/dev/null || true
			gpart set -a lenovofix "${disk}" 2>/dev/null || true
			echo "GPT BIOS bootcode and active flags configured on /dev/${disk}."
		fi
	elif [ "${part_scheme}" = "MBR" ]; then
		echo "Installing MBR BIOS bootcode on /dev/${disk}..."
		if [ -f "/boot/boot0" ]; then
			gpart bootcode -b /boot/boot0 "${disk}" 2>/dev/null || true
		fi
		if [ -f "/boot/boot" ] && [ -e "/dev/${disk}s1" ]; then
			gpart bootcode -b /boot/boot "${disk}s1" 2>/dev/null || true
		fi
		gpart set -a active -i 1 "${disk}" 2>/dev/null || true
	fi
done

sync; sync; sync

echo "=== MitraNet OS Installation Complete ==="
exit 0
