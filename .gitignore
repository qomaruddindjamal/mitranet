# MitraNet .gitignore

# ISO, Images & Large Binary Files (prevent uploading large >100MB files to GitHub)
sources/*.iso
sources/*.img
images/*.iso
images/*.img
images/*.img.gz
images/*.qcow2
images/*.vmdk
images/*.vhdx
images/*.tar.gz
images/*.zip
images/releases/
vm/*.vhdx
vm/*.vhd
vm/*.avhdx
vm/*.raw
*.iso
*.img
*.qcow2
*.vmdk
*.vhdx
*.vhd
*.avhdx

# Build outputs & extraction workspaces
bulid/workspace/
bulid/extracted/
bulid/rootfs/
bulid/iso_root/
bulid/boot/
bulid/output/
_temp*/

# Recreated rescue hardlinks (generated on demand by restore_links before ISO build)
sources/netgate/rescue/*
!sources/netgate/rescue/rescue
!sources/netgate/rescue/dhclient-script
!sources/netgate/rescue/links.txt
!sources/netgate/rescue/restore_links.sh
!sources/netgate/rescue/restore_links.ps1

# Logs & temp files
*.log
*.tmp
*.debug
*.core
*.sqlite
!var/db/pkg/local.sqlite
__pycache__/
*.pyc

# OS and Editor artifacts
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
