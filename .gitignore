# MitraNet .gitignore

# ISO, Images & Large Binary Files (prevent uploading large >100MB files to GitHub)
sources/*.iso
sources/*.img
images/*.iso
images/*.img
images/*.img.gz
images/*.qcow2
images/*.vmdk
images/*.vhdx
images/*.tar.gz
images/*.zip
images/releases/
vm/*.vhdx
vm/*.vhd
vm/*.avhdx
*.iso
*.img
*.qcow2
*.vmdk
*.vhdx
*.vhd
*.avhdx

# Build outputs & extraction workspaces
bulid/workspace/
bulid/extracted/
bulid/rootfs/
bulid/iso_root/
bulid/boot/
bulid/output/
_temp*/

# Logs & temp files
*.log
*.tmp
*.sqlite
!var/db/pkg/local.sqlite
__pycache__/
*.pyc

# OS and Editor artifacts
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
