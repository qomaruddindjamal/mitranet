# ============================================================
# MitraNet Lab Credentials (TEMPLATE)
# Copy this file to ".env" and fill in real values.
# ".env" is gitignored - NEVER commit it, never put real values here.
# ============================================================

# --- Mini PC (deployment target) ---
MITRANET_MINIPC_HOST=
MITRANET_MINIPC_USER=root
MITRANET_MINIPC_PASS=

# --- VirtualBox host-only lab machine ---
MITRANET_LAB_HOST=
MITRANET_LAB_USER=root
MITRANET_LAB_PASS=

# --- Lab VM (internal) ---
MITRANET_VM_HOST=
MITRANET_VM_USER=root
MITRANET_VM_PASS=

# --- Lab VM via NAT port-forward ---
MITRANET_VM_NAT_HOST=127.0.0.1
MITRANET_VM_NAT_PORT=2222

# --- Booster VPS (fill if used by ops scripts) ---
MITRANET_VPS_HOST=
MITRANET_VPS_USER=root
MITRANET_VPS_PASS=

# --- WebUI HTTP login (form / cookie auth) ---
MITRANET_WEBUI_USER=admin
MITRANET_WEBUI_PASS=
