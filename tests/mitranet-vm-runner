#!/bin/bash
VM_NAME="$1"
CONFIG="/etc/mitranet/vms/${VM_NAME}.env"

RAM_MB=1024
VCPU=1
PORT_FWD=8888
ISO_FILE=""
VNC_PORT=5900
NET_MODE="veth"
VETH_IFACE="veth0"

if [ -f "$CONFIG" ]; then
    source "$CONFIG"
fi

DISK="/var/lib/mitranet/vms/${VM_NAME}/disk.qcow2"
ARGS=(
    -name "${VM_NAME}"
    -m "${RAM_MB:-1024}"
    -smp "${VCPU:-1}"
    -display vnc=127.0.0.1:0
    -drive "file=${DISK},if=virtio,format=qcow2"
)

# Network configuration: TAP on vEthernet Bridge or Slirp User Mode
TAP_DEV="tap-${VM_NAME}"
if [ "$NET_MODE" = "veth" ] && [ -n "$VETH_IFACE" ] && ip link show "$VETH_IFACE" >/dev/null 2>&1; then
    # Ensure TAP interface exists and is attached to the vEthernet bridge
    ip link del "$TAP_DEV" >/dev/null 2>&1 || true
    ip tuntap add dev "$TAP_DEV" mode tap
    ip link set "$TAP_DEV" master "$VETH_IFACE"
    ip link set "$TAP_DEV" up

    ARGS+=(
        -netdev "tap,id=net0,ifname=${TAP_DEV},script=no,downscript=no"
        -device "virtio-net-pci,netdev=net0"
    )

    # Trap exit to cleanup TAP device
    trap 'ip link del "$TAP_DEV" >/dev/null 2>&1 || true' EXIT
else
    # Fallback to SLIRP user networking with hostfwd
    ARGS+=(
        -netdev "user,id=net0,hostfwd=tcp::${PORT_FWD:-8888}-:8888"
        -device "virtio-net-pci,netdev=net0"
    )
fi

# Attach ISO if configured
if [ -n "$ISO_FILE" ] && [ -f "$ISO_FILE" ]; then
    ARGS+=( -cdrom "$ISO_FILE" -boot d )
fi

# Launch background websockify to expose noVNC on port 6080 if not already running
if ! pgrep -f "websockify.*6080" >/dev/null; then
    websockify -D --web /usr/share/novnc 6080 127.0.0.1:5900 &
fi

exec /usr/bin/qemu-system-x86_64 "${ARGS[@]}"

