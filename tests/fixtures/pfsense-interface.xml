<pfsense>
  <version>24.5</version>
  <interfaces>
    <wan>
      <enable>1</enable>
      <if>vtnet0</if>
      <ipaddr>dhcp</ipaddr>
    </wan>
    <lan>
      <enable>1</enable>
      <if>vtnet1</if>
      <ipaddr>172.16.0.1</ipaddr>
      <subnet>24</subnet>
    </lan>
    <opt1>
      <enable>1</enable>
      <if>vtnet2</if>
      <ipaddr>10.10.10.1</ipaddr>
      <subnet>24</subnet>
    </opt1>
  </interfaces>
  <vlans>
    <vlan>
      <if>vtnet1</if>
      <tag>100</tag>
      <vif>vlan100</vif>
      <descr>GUEST_WIFI</descr>
    </vlan>
  </vlans>
  <bridges>
    <bridged>
      <bridgeif>br0</bridgeif>
      <members>lan,opt1</members>
      <stp>1</stp>
      <descr>LAN_OPT_BRIDGE</descr>
    </bridged>
  </bridges>
</pfsense>
