        "action": "accept",
        "direction": "in",
        "interface": "lan",
        "protocol": "any",
        "source": "any",
        "source_port": null,
        "destination": "any",
        "destination_port": null,
        "log": false,
        "description": "Default allow LAN to any rule"
      },
      {
        "id": "0100000102",
        "enabled": true,
        "action": "accept",
        "direction": "in",
        "interface": "lan",
        "protocol": "any",
        "source": "any",
        "source_port": null,
        "destination": "any",
